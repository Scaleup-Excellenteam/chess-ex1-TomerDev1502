#— Ignore ALL “out” and “build” directories anywhere in the tree
**/out/
**/build/

#— CMake generated files
CMakeCache.txt
CMakeFiles/
**/.cmake/

#— Compiled objects, libs, executables
*.o
*.a
*.so
*.exe
*.out

#— Visual Studio (and VSCode) settings
.vs/
.vscode/

#— IDE/editor swap & logs
*.swp
*.swo
*.log
*.tmp
*.bak

#— GitHub Actions temp
.github/workflows/*.log
.github/workflows/*.cache

#— Your image cache
img/cache/
